# Copy to .env for local development. Never commit the real .env — it is in
# .gitignore for that reason. In production these come from the host's secret
# manager, never from a file in git.

# Qumo's own database. Separate from CIOS on purpose: the two products share
# no tables and no runtime, so a schema change on one side cannot break the
# other. See docs/qumo-architecture.md.
DATABASE_URL="postgresql://qumo_dev:qumo_dev_local_only@localhost:5432/qumo_dev"

# Signs the shopper session cookie. Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-secret"

# Auth.js-style host trust. Only matters once the brand console lands and
# brings a staff login with it; harmless now, and documented here because
# running a production build locally without it fails in a way that reads as
# a broken page rather than a missing variable.
AUTH_TRUST_HOST="true"

# PII protection for shopper phone numbers (lib/security/crypto.ts).
# PHONE_HASH_SECRET: openssl rand -base64 32
# ENCRYPTION_KEY:    openssl rand -base64 32   (must be 32 raw bytes for AES-256)
PHONE_HASH_SECRET="replace-with-a-generated-secret"
ENCRYPTION_KEY="replace-with-a-generated-32-byte-key"

# SMS for shopper login passcodes. Twilio Messaging rather than Twilio
# Verify — the passcode lifecycle (hashing, expiry, attempt cap, single use)
# lives in lib/consumer/otp.ts so it stays testable and provider-independent,
# and swapping to a South African aggregator is one class in
# lib/sms/client.ts. Left empty, a logging implementation prints the passcode
# to the console and the whole login flow runs with no account provisioned.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Authenticates the scheduled call to /api/cron/sweep-sessions, which deletes
# shopper session rows long past expiry. Generate any random string:
# openssl rand -hex 32. Left empty the route always 401s and nothing is ever
# deleted — the safe direction for a URL whose job is deletion.
CRON_SECRET=""
